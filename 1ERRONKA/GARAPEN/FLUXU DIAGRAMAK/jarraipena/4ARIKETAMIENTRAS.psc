Algoritmo sin_titulo
	kontadorea <- 0
	Definir liburuak Como Cadena
	Escribir 'zein liburu artu duzu?'
	Leer liburuak
	Mientras liburuak<>"amaitu" Hacer
		kontadorea <- kontadorea+1
		Escribir 'Nola da liburuaren izenburua?'
		Escribir 'sartu amaitu bukatzeko'
		Leer liburuak
	FinMientras
	Escribir kontadorea, ' liburu artu dituzu'
FinAlgoritmo
