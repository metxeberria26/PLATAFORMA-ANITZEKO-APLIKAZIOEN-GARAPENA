Algoritmo sin_titulo
	definir a Como Caracter
	definir bidaia como real
	bidaia=15.0
	kontadorea=0
	a="bai"
	mientras a<>"ez" y bidaia>0 Hacer
		escribir"Bidaia bat nahi duzu egin? bai edo ez"
