Algoritmo sin_titulo
	suma <- 0
	
    Para pertsona <- 1 Hasta 8 Hacer
		
        Escribir "Zenbat gastatu duzu?"
        Leer gastua
		
        suma <- suma + gastua
		
        Escribir "Pertsona honen gastua: ", gastua
		
    FinPara
	
    batezbestekoa <- suma / 8
	
    Escribir "Pertsona guztien batez besteko gastua: ", batezbestekoa
FinAlgoritmo
