Algoritmo sin_titulo
	Definir zenbakia Como Entero
	Definir kontadorea Como Entero
	kontadorea <- 0
	Mientras kontadorea<10 Hacer
		Escribir 'Idatzi zenbaki bat:'
		Leer zenbakia
		Si zenbakia MOD 2=0 Entonces
			Escribir 'Bikoitia: ', zenbakia
		FinSi
		kontadorea <- kontadorea+1
	FinMientras
FinAlgoritmo
